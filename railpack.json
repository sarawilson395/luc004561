{
  "$schema": "https://schema.railpack.com",
  "deploy": {
    "aptPackages": [
      "...",
      "ca-certificates",
      "tzdata"
    ],
    "variables": {
      "PORT": "8080",
      "TZ": "UTC",
      "GOGC": "100",
      "GODEBUG": "madvdontneed=1",
