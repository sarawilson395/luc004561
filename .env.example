# ==============================================================================
# BERMUDA PORTAL - LUCITY CLOUD ENVIRONMENT CONFIGURATION TEMPLATE
# Target Baseline: 1 vCPU / 1 GB RAM (Hetzner eu-central / ch-central)
# ==============================================================================

# [Required for Custom Domain DNS Sync] Cloudflare API Token with Zone/DNS Edit permissions
CLOUDFLARE_API_TOKEN=

# [Recommended for Auto-Provisioning] Lucity Cloud Workspace API Token (Role: Admin)
LUCITY_API_TOKEN=

# [Recommended] Custom Domain routed via Cloudflare DNS-Only (e.g. portal.yourdomain.dpdns.org)
CUSTOM_DOMAIN=

# [Recommended] Master Secret Seed for Deterministic Key Derivation (Locked across restarts)
BERMUDA_MASTER_KEY=

# [Optional] Explicit Lucity Domain Ownership TXT Token (_lucity-verify value)
LUCITY_VERIFY_TOKEN=

# [Optional] Explicit Cloudflare Zone ID (Auto-discovered if left empty)
CLOUDFLARE_ZONE_ID=

# [Optional] Deployment Region Identifier (Default: eu-central)
# Supported: eu-central, ch-central, europe-west4, us-east4, us-west, asia-southeast1
BERMUDA_REGION=eu-central

